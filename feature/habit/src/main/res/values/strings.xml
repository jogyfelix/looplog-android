    <string name="ai_notice_title">Before you use AI</string>
    <string name="ai_notice_intro">looplog uses on-device AI to help turn your goals into practical habits.</string>
    <string name="ai_notice_mistakes_title">AI can make mistakes</string>
    <string name="ai_notice_mistakes_body">Suggestions may be inaccurate, inappropriate, or incomplete. Review each suggestion before adding it. Do not rely on this feature for medical, mental-health, legal, financial, or other professional advice.</string>
    <string name="ai_notice_on_device_title">Processed on your device</string>
    <string name="ai_notice_on_device_body">Your goal and generated suggestions are processed on your device. looplog does not send their contents to its servers or include them in analytics or error reports.</string>
    <string name="ai_notice_sensitive_title">Protect your information</string>
    <string name="ai_notice_sensitive_body">looplog does not ask for personal or sensitive information. Avoid entering information you would not want processed on your device.</string>
    <string name="ai_notice_models">Depending on your device, this feature uses Gemini Nano or a locally installed Gemma 3 model.</string>
    <string name="ai_notice_telemetry">looplog collects technical AI events, such as whether generation succeeded and how long it took, without collecting your goal or generated suggestions.</string>
    <string name="ai_notice_acknowledgement">By continuing, you acknowledge this AI notice. Your use of looplog remains subject to the Terms of Service.</string>
